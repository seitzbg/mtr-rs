# SPDX-License-Identifier: GPL-2.0-only
# pkg(8) manifest template; scripts/build-freebsd-pkg.sh fills in @VERSION@ and @ABI@ and adds
# the file list from pkg-plist. UCL syntax (see pkg-create(8)).
name: "mtr-rs"
version: "@VERSION@"
origin: "net/mtr-rs"
comment: "Rust port of mtr (My TraceRoute): terminal UI, reports, wire-compatible probe helper"
desc: <<EOD
Rust port of mtr (My TraceRoute) with an interactive terminal UI, the classic
report/JSON/CSV modes, and a privileged probe helper (mtr-rs-packet) that is
wire-compatible with mtr 0.96's mtr-packet. Installs bin/mtr-rs and a
setuid-root bin/mtr-rs-packet alongside any ports mtr.
EOD
maintainer: "171158+seitzbg@users.noreply.github.com"
www: "https://github.com/seitzbg/mtr-rs"
abi: "@ABI@"
prefix: "/usr/local"
licenselogic: "single"
licenses: ["GPLv2"]
categories: ["net"]
